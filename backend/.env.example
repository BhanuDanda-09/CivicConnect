# ==============================================================================
# CivicConnect Backend - Environment Configuration Template
# Copy this file to '.env' inside 'backend/' and supply your actual values.
# NEVER commit the actual '.env' file containing secrets to version control.
# ==============================================================================

# Server Network & Runtime Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL (For CORS allowlist & credentials)
FRONTEND_URL=http://localhost:5173

# Database Connection URI
# Local MongoDB: mongodb://127.0.0.1:27017/civicconnect
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/civicconnect?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/civicconnect

# JWT Authentication & Cookie Controls (Phase 4)
JWT_SECRET=super_secret_jwt_key_civicconnect_change_in_production
JWT_EXPIRES_IN=1d
JWT_COOKIE_EXPIRES_IN=1
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Cloudinary Media Storage (Used in Phase 5)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Rate Limiting Controls
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20
