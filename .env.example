# ==============================================================================
# SMART CIVIC COMPLAINT MANAGEMENT SYSTEM - ENVIRONMENT TEMPLATE
# Copy this file to '.env' and fill in the actual values.
# NEVER commit your real '.env' file containing actual secrets to Git.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (Local MongoDB or MongoDB Atlas)
# Local: mongodb://localhost:27017/smart_civic_db
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart_civic_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/smart_civic_db

# Authentication / JWT Configuration
JWT_SECRET=super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Cloudinary Storage Configuration (for complaint image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Vite Frontend Variables (Accessible in frontend via import.meta.env)
VITE_API_BASE_URL=http://localhost:5000/api

